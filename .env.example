# ─── KusinaCost Environment Variables ────────────────────────────────────
# Copy this file to `.env.local` and fill in your Supabase credentials.
# If left empty, the app runs in localStorage-only mode (single user, no auth).

# Supabase project URL — e.g. https://xxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe to expose in client)
VITE_SUPABASE_ANON_KEY=
